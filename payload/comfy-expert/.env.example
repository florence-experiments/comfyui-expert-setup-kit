# Copy to .env and fill in what you have. All optional. Never share this file.
# Civitai: civitai.com > Account settings > API Keys (needed for some downloads; Civitai is blocked in some countries, e.g. the UK)
CIVITAI_API_KEY=
# Hugging Face READ token for gated repos: https://huggingface.co/settings/tokens
HF_TOKEN=
# GitHub token (no scopes needed) raises the search limit: https://github.com/settings/tokens
GITHUB_TOKEN=
# Override settings without editing config.yaml:
# LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# COMFYUI_URL=http://127.0.0.1:8188
# UI_PORT=7860
# MCP_PORT=8765
# MCP_TOKEN=choose-a-long-random-string
# HTTPS_PROXY_FOR_TOOLS=
